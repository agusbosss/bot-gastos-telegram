# ─── Telegram ───
# Token que te da @BotFather al crear el bot.
GASTOS_BOT_TOKEN=tu_token_de_botfather
# Tu ID de usuario de Telegram: el bot solo le contesta a este chat.
GASTOS_CHAT_ID=tu_chat_id

# ─── Claude (Anthropic) ───
ANTHROPIC_API_KEY=tu_api_key_de_anthropic

# ─── Groq: transcripción de notas de voz (opcional, gratis en console.groq.com) ───
GROQ_API_KEY=tu_api_key_de_groq
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ─── Google Apps Script (la planilla) ───
# URL del Web App (termina en /exec) y el token que te mostró setupPlanilla().
APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_ID/exec
APPS_SCRIPT_SECRET=el_token_que_genero_setupPlanilla

# ─── Base de datos (historial, memorias y recordatorios) ───
# En Railway, montá un volumen en /data y usá: sqlite:////data/agent.db
# (sin volumen, cada deploy borra el historial y las memorias).
DATABASE_URL=sqlite:///./agent.db

# ─── App ───
TIMEZONE=America/Argentina/Buenos_Aires
PORT=8000
LOG_LEVEL=INFO

# ─── Seguridad del webhook (recomendado) ───
# Cualquier texto largo y aleatorio. Se pasa también como secret_token al
# registrar el webhook, así el bot ignora requests que no vengan de Telegram.
WEBHOOK_SECRET=
